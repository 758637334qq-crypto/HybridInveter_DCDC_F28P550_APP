      Parameter {
        Variable      "StartFcn"
        Value         "Dab_Init();\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "{\n"
"    static double last_tick = -1.0;\n"
"\n"
"    float vo     = InputSignal(0, 0);\n"
"    float ibus   = InputSignal(0, 1);\n"
"    float iload  = InputSignal(0, 2);\n"
"    float vb     = InputSignal(0, 3);\n"
"\n"
"    if (IsMajorStep && IsSampleHit(0) && CurrentTime > last_tick + 0.5 / 6000"
"0.0)\n"
"    {\n"
"        Dab_Tick(vo, vb, ibus, fmaxf(0.0f, iload));\n"
"        last_tick = CurrentTime;\n"
"    }\n"
"\n"
"    OutputSignal(0, 0) = held_hv;\n"
"    OutputSignal(1, 0) = fault;\n"
"    OutputSignal(1, 1) = stDabDuty0.f32Duty;\n"
"    OutputSignal(2, 0) = vo;\n"
"    OutputSignal(2, 1) = vref;\n"
"    OutputSignal(2, 2) = Bus.f32Out;\n"
"    OutputSignal(3, 0) = Bus.f32Ref;\n"
"    OutputSignal(3, 1) = ibus;\n"
"    OutputSignal(3, 2) = Bus.u16RampDone;\n"
"    OutputSignal(4, 0) = held_lv;\n"
"}"
        Show          off
      }
